{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/calculator",
      "destination": "/catalog",
      "type": 301
    },
    {
      "source": "/blog",
      "destination": "/how-it-works",
      "type": 301
    },
    {
      "source": "/blog/**",
      "destination": "/how-it-works",
      "type": 301
    },
    {
      "source": "/catalog/lg_detergent",
      "destination": "/catalog/tehnika-dlya-doma",
      "type": 301
    },
    {
      "source": "/catalog/asusprobook15",
      "destination": "/catalog/noutbuki",
      "type": 301
    },
    {
      "source": "/catalog/macbookpro16m3max512",
      "destination": "/catalog/noutbuki",
      "type": 301
    },
    {
      "source": "/catalog/sgw7",
      "destination": "/catalog/chasy",
      "type": 301
    },
    {
      "source": "/catalog/lgtvoled75",
      "destination": "/catalog/televizory",
      "type": 301
    },
    {
      "source": "/catalog/hppaviliondm15",
      "destination": "/catalog/noutbuki",
      "type": 301
    },
    {
      "source": "/catalog/sonykx80",
      "destination": "/catalog/televizory",
      "type": 301
    },
    {
      "source": "/catalog/ztaxon70ultra",
      "destination": "/catalog/smartfony",
      "type": 301
    },
    {
      "source": "/catalog/realme12pro",
      "destination": "/catalog/smartfony",
      "type": 301
    },
    {
      "source": "/catalog/tcltab12pro",
      "destination": "/catalog/planshety",
      "type": 301
    },
    {
      "source": "/catalog/clevop775",
      "destination": "/catalog/noutbuki",
      "type": 301
    },
    {
      "source": "/catalog/pixelbookgo",
      "destination": "/catalog/noutbuki",
      "type": 301
    },
    {
      "source": "/catalog/jblbar1000pro",
      "destination": "/catalog/naushniki",
      "type": 301
    },
    {
      "source": "/catalog/medbottle",
      "destination": "/catalog/tehnika-dlya-doma",
      "type": 301
    },
    {
      "source": "/catalog/arellapro",
      "destination": "/catalog/tehnika-dlya-doma",
      "type": 301
    }
  ],
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/healthz.txt"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog/index.html"
    },
    {
      "source": "/catalog/:id([a-z0-9_-]+)",
      "destination": "/catalog/:id/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/legal/:docType([a-z-]+)",
      "destination": "/legal/:docType/index.html"
    },
    {
      "source": "/login",
      "destination": "/spa.html"
    },
    {
      "source": "/register",
      "destination": "/spa.html"
    },
    {
      "source": "/demo",
      "destination": "/spa.html"
    },
    {
      "source": "/pay/:paymentId",
      "destination": "/spa.html"
    },
    {
      "source": "/cart",
      "destination": "/spa.html"
    },
    {
      "source": "/login/:who",
      "destination": "/spa.html"
    },
    {
      "source": "/account",
      "destination": "/spa.html"
    },
    {
      "source": "/account/**",
      "destination": "/spa.html"
    },
    {
      "source": "/staff",
      "destination": "/spa.html"
    },
    {
      "source": "/staff/**",
      "destination": "/spa.html"
    },
    {
      "source": "/checkout",
      "destination": "/spa.html"
    },
    {
      "source": "/dashboard",
      "destination": "/spa.html"
    },
    {
      "source": "/dashboard/**",
      "destination": "/spa.html"
    },
    {
      "source": "/admin",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/**",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/{og,icons}/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/{favicon.ico,favicon.svg,apple-touch-icon.png}",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/{sitemap.xml,robots.txt}",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/healthz.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
