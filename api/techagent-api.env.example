# /etc/techagent-api.env — настройки сервера заказов (права root:techagent 640)
PORT=8787
DB_PATH=/var/lib/techagent-api/techagent.db
CATALOG_PATH=/opt/techagent-api/catalog.json
PUBLIC_URL=https://techagent.pro
DELIVERY_PRICE=350
# Письма: свой файл msmtp (root:techagent 640), аккаунт в нём и ящик-отправитель на techagent.pro. Пусто — письма не уходят
MAIL_CONFIG=/etc/techagent-msmtprc
MAIL_ACCOUNT=
MAIL_FROM=
# Куда приходят уведомления о новых заказах (сотрудникам)
ORDERS_EMAIL_TO=
# Карта пунктов СДЭК на оформлении: ключи интеграции СДЭК и ключ JavaScript API Яндекс Карт
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
YMAPS_KEY=
# Задаётся командой set-staff-password.mjs
STAFF_PASSWORD_HASH=
